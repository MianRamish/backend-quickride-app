# Runtime
ENVIRONMENT=development
PORT=4000

# MongoDB Atlas (recommended)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/quickride?retryWrites=true&w=majority
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=0
MONGODB_MAX_IDLE_TIME_MS=30000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_AUTO_INDEX=true

# Auth
JWT_SECRET=replace-with-a-long-random-secret

# Frontend origins (comma-separated when needed)
CLIENT_URL=http://localhost:5173
CLIENT_ORIGINS=http://localhost:5173

# Keep request bodies below MongoDB's 16 MB BSON document limit while files are still stored as base64.
REQUEST_BODY_LIMIT=12mb

# Initial admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Email
DISABLE_EMAIL_VERIFICATION=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=your-smtp-user@example.com
MAIL_PASS=your-smtp-app-password
MAIL_FROM=QuickRide <no-reply@example.com>

# Map providers / geocoding
NOMINATIM_URL=https://nominatim.openstreetmap.org
PHOTON_URL=https://photon.komoot.io
OSRM_URL=https://router.project-osrm.org
MAP_COUNTRY_CODES=ng
MAP_SEARCH_BBOX=2.676932,4.272162,14.678014,13.892007
GEOCODING_USER_AGENT=QuickRide/1.0
